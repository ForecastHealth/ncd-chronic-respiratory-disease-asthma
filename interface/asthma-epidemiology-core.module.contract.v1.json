{
  "schema": "botech.module-contract.v1",
  "module_id": "asthma_epidemiology_core",
  "module_type": "disease_epidemiology",
  "owner": {
    "repo_id": "ncd-asthma",
    "repo_ref": "ncd-asthma"
  },
  "version": "v1",
  "runtime_role": "compiled_together",
  "owned_parameters": [],
  "declared_inputs": [
    {
      "channel_id": "population_at_risk_opening",
      "meaning": "Opening asthma-local population at risk, seeded from the demographic substrate.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "owner_module_id": "demographic_substrate"
    },
    {
      "channel_id": "births",
      "meaning": "Birth inflow supplied by the demographic substrate when asthma is compiled with demography.",
      "shape": "2x101",
      "units": "people",
      "required": false,
      "owner_module_id": "demographic_substrate"
    },
    {
      "channel_id": "background_mortality_rate",
      "meaning": "All-cause background mortality rate supplied by the demographic substrate.",
      "shape": "2x101",
      "units": "rate",
      "required": true,
      "owner_module_id": "demographic_substrate",
      "binding": {
        "legacy_lowering_ref": "$.links[?(@.id=='kdE7JaZO')].generate_array"
      }
    },
    {
      "channel_id": "net_migration_rate",
      "meaning": "Age-sex-specific projected net migration rate supplied by the demographic substrate and applied proportionally to asthma-local living states.",
      "shape": "2x101",
      "units": "rate",
      "required": false,
      "owner_module_id": "demographic_substrate",
      "binding": {
        "legacy_lowering_ref": "compiler lowerer supplies migration_projection_rate to asthma living-state self-links"
      }
    },
    {
      "channel_id": "incidence_modifier",
      "meaning": "Optional source-owned risk-factor modifier applied to asthma incidence.",
      "shape": "yearly_2x101_or_scalar",
      "units": "multiplier",
      "required": false,
      "accepted_source_module_type": "risk_factor",
      "input_semantics": "multiplicative_incidence_modifier",
      "binding": {
        "legacy_lowering_ref": "$.nodes[?(@.id=='4iPxzqKo')].compiler_binding",
        "target_node_id": "4iPxzqKo",
        "target_node_label": "AsthmaEpsd Incidence",
        "target_path": "asthma_incidence_surrogate",
        "target_operator": "multiply"
      }
    },
    {
      "channel_id": "asthma_disability_effect_transform",
      "accepted_source_module_type": "clinical_intervention",
      "input_semantics": "additive_disability_effect_reduction",
      "meaning": "Optional component-owned asthma clinical intervention disability reductions. Intervention components add their effect into this shared transform before asthma disability weight is recalculated.",
      "required": false,
      "shape": "yearly_2x101_or_scalar",
      "units": "proportion",
      "binding": {
        "legacy_lowering_ref": "$.nodes[?(@.id=='Disability_Effect_Transform')]",
        "target_node_id": "Disability_Effect_Transform",
        "target_node_label": "Disability_Effect_Transform",
        "target_operator": "add",
        "target_path": "asthma_disability_effect_transform",
        "postprocessing": {
          "negative": true
        }
      }
    },
    {
      "channel_id": "asthma_mortality_effect_transform",
      "accepted_source_module_type": "clinical_intervention",
      "input_semantics": "additive_mortality_effect_reduction",
      "meaning": "Optional component-owned asthma clinical intervention mortality reductions. Intervention components add their effect into this shared transform before asthma mortality is recalculated.",
      "required": false,
      "shape": "yearly_2x101_or_scalar",
      "units": "proportion",
      "binding": {
        "legacy_lowering_ref": "$.nodes[?(@.id=='Mortality_Effect_Transform')]",
        "target_node_id": "Mortality_Effect_Transform",
        "target_node_label": "Mortality_Effect_Transform",
        "target_operator": "add",
        "target_path": "asthma_mortality_effect_transform"
      }
    }
  ],
  "published_outputs": [
    {
      "channel_id": "asthma_episode_population",
      "meaning": "People currently in the asthma episode state.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "node_id": "AsthmaEpsd"
      }
    },
    {
      "channel_id": "asthma_incidence_flow",
      "meaning": "New asthma episode flow.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "node_id": "4iPxzqKo"
      }
    },
    {
      "channel_id": "asthma_mortality_flow",
      "meaning": "Asthma-specific mortality flow.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "node_id": "AsthmaEpsd Mortality"
      }
    }
  ],
  "marginal_disease_process": {
    "schema": "forecast-health.marginal-disease-process.v1",
    "population_semantics": "non_additive_marginal_estimate",
    "main_population_owner_module_id": "demographic_substrate",
    "population_partition": {
      "semantics": "mutually_exclusive_exhaustive",
      "living_state_node_ids": [
        "DsFreeSus",
        "AsthmaEpsd"
      ],
      "residual_state_node_id": "DsFreeSus",
      "residual_state_semantics": {
        "classification": "derived_marginal_residual",
        "authoritative_population": false,
        "meaning": "People in the canonical population who are not in the declared asthma state in this marginal disease process.",
        "opening_calculation": "canonical_population_minus_declared_non_residual_states",
        "annual_calculation": "carried as the incidence source inside the marginal process, then rebased with all living asthma states to canonical survivors"
      }
    },
    "cause_specific_mortality": {
      "excludes_demographic_background_mortality": true,
      "units": "deaths",
      "output_link_ids": [
        "dgLZdA4x"
      ],
      "output_semantics": "Values emitted by the Botech EDGE_VALUES_CALCULATED events for these links are actual cause-specific death flows. Case-fatality helper nodes are not mortality outputs."
    },
    "morbidity": {
      "metric_input_contract_ref": "interface/asthma-epidemiology-core.metric-inputs.v1.json",
      "aggregation_semantics": "comparison_minus_baseline_yld_rate"
    }
  },
  "state_initialization": {
    "mode": "opening_state_reconciliation_required",
    "reconciliation_module_id": "opening-state-reconciliation",
    "recipe_ref": "data/asthma-opening-balance-seed.recipe.v1.json",
    "scenario_policy": "one_baseline_only_artifact_shared_by_baseline_and_comparison",
    "targets": [
      "AsthmaEpsd",
      "DsFreeSus"
    ]
  },
  "runtime_data_requirements": [
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "Asthma",
        "measure": "prevalence"
      },
      "required_for": [
        "state_initialization"
      ]
    },
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "Asthma",
        "measure": "incidence"
      },
      "required_for": [
        "asthma_incidence_flow"
      ]
    },
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "Asthma",
        "measure": "deaths"
      },
      "required_for": [
        "asthma_mortality_flow"
      ]
    },
    {
      "data_type": "asthma.get_observation",
      "parameters": {
        "country": "ISO3",
        "observation": "AsthmaEpsd -> Disability"
      },
      "required_for": [
        "asthma_disability_weight"
      ]
    },
    {
      "data_type": "healthy_disability",
      "parameters": {
        "country": "ISO3"
      },
      "required_for": [
        "healthy_years_lived"
      ]
    },
    {
      "data_type": "yll_weights",
      "parameters": {},
      "required_for": [
        "years_of_life_lost"
      ]
    }
  ],
  "provenance": {
    "default_sources": [
      {
        "source_id": "spectrum_onehealth_asthma",
        "use": "asthma epidemiology and intervention defaults"
      },
      {
        "source_id": "current_method_fix_reference",
        "use": "current reference behavior target"
      }
    ],
    "unresolved": [
      {
        "item": "economic value helper nodes in current runnable graph",
        "reason": "The current model.json still contains GDP, labour-force participation, and economic value helper nodes from the old all-in-one model. They are not part of this asthma module contract and should move when resources, costs, and benefits are separated."
      }
    ]
  },
  "compiler_composition": {
    "schema": "forecast-health.botech-disease-composition.v1",
    "target_key": "asthma",
    "model_slug": "ncd-asthma",
    "label": "Asthma",
    "baseline_template_id": "asthma_baseline",
    "permitted_comparison_template_ids": [
      "asthma_baseline"
    ],
    "materializer": {
      "command_ref": "scripts/orchestrator_scenarios.py",
      "model_output_ref": "model.json"
    },
    "lowering_profile": "partitioned_disease_v1",
    "lowering": {
      "data_fetcher_label": "asthma",
      "prevalence_inputs": {
        "asthma_prevalence": {
          "data_fetcher_label": "fhdb",
          "method": "epidemiology",
          "parameters": {
            "disease": "Asthma",
            "measure": "prevalence"
          }
        }
      },
      "incidence_edges": [
        {
          "id": "compiler::asthma::incidence_from_disease_free_population",
          "label": "Asthma incidence from disease-free population",
          "target_surrogate": "4iPxzqKo",
          "target_state": "AsthmaEpsd",
          "target_transition_edge_id": "wAhdgLwg"
        }
      ],
      "disable_subroutine_edges": [
        "HGzwp14L"
      ],
      "background_mortality_edges": [
        "kdE7JaZO"
      ],
      "age_states": [
        "AsthmaEpsd"
      ],
      "birth_sources": [
        "DsFreeSus",
        "AsthmaEpsd"
      ],
      "living_state_nodes": [
        "DsFreeSus",
        "AsthmaEpsd"
      ],
      "headline_nodes": {
        "Disease-free population": "DsFreeSus",
        "Asthma episode population": "AsthmaEpsd"
      }
    }
  },
  "validation": {
    "internal_validity_tests": [
      "python scripts/validate_module_contract.py"
    ],
    "face_validity_checks": []
  },
  "implementation_notes": [
    "Appendix 3 CR1 and CR3 intervention graph slices are source-owned by ncd-asthma-asthmaoralprednisolone, ncd-asthma-lowdosebeclom, ncd-asthma-highdosebeclom, and ncd-asthma-inhaledshortactingbeta. The asthma module keeps the shared disease states and transform landing nodes.",
    "HYL, YLL, YLD and DALY calculations are owned by metric modules, not by this disease graph. This disease module publishes raw disease rows needed by those metric modules."
  ]
}
