{
  "schema": "forecast-health.disease-opening-state-contract.v3",
  "contract_id": "ncd-asthma-opening-state",
  "module_id": "asthma_epidemiology_core",
  "version": "v3",
  "reconciliation_module_id": "opening-state-reconciliation",
  "purpose": "Declare the asthma rate calibration applied by the shared opening-state reconciliation.",
  "scenario_policy": {
    "inputs": "baseline_only",
    "comparison_intervention_inputs_allowed": false,
    "artifact_reuse": "same_content_hash_for_baseline_and_all_comparisons"
  },
  "rate_calibration": {
    "schema": "forecast-health.disease-rate-calibration.v1",
    "method_id": "attributed_cause_specific_death_fit.v1",
    "authorization": {
      "status": "authorized",
      "recorded_date": "2026-10-05",
      "authority": "Rory Watts and Robert Totanes (WHO) approved disease-model calibration. Rory delegated the method decisions of 5 October 2026 to the team lead, who adopted WHO GHE 2021 cause-specific deaths as the death target, a 28-day per-episode reading of acute case fatality with acute deaths capped at half of target deaths, and cohort-consistent opening complication shares.",
      "scope": "Opening-year attributed deaths only. Prevalence after the opening year is not a target of this method version."
    },
    "states": [
      "DsFreeSus",
      "AsthmaEpsd"
    ],
    "residual_state": "DsFreeSus",
    "rates": {
      "asthma_incidence": {
        "source": {
          "data_type": "fhdb.epidemiology",
          "parameters": {
            "country": "$country",
            "disease": "Asthma",
            "measure": "incidence"
          }
        },
        "unit": "population_rate",
        "apply": "susceptible_incidence_scale"
      },
      "asthma_remission": {
        "source": {
          "data_type": "asthma.get_observation",
          "parameters": {
            "country": "$country",
            "observation": "AsthmaEpsd -> DsFreeSus"
          }
        },
        "unit": "annual_hazard",
        "runtime_binding": {
          "link_id": "Z6UVoLxv"
        },
        "meaning": "Fitted by age band so the year carries observed asthma prevalence forward unchanged."
      },
      "asthma_fatality": {
        "source": {
          "data_type": "fhdb.epidemiology",
          "parameters": {
            "country": "$country",
            "disease": "Asthma",
            "measure": "deaths"
          }
        },
        "unit": "annual_hazard",
        "upper_bound": 3.0,
        "runtime_binding": {
          "source_node_id": "AsthmaEpsd_CFR"
        }
      }
    },
    "transitions": [
      {
        "from": "DsFreeSus",
        "to": "AsthmaEpsd",
        "rate": "asthma_incidence"
      },
      {
        "from": "AsthmaEpsd",
        "to": "DsFreeSus",
        "rate": "asthma_remission"
      },
      {
        "from": "AsthmaEpsd",
        "to": null,
        "rate": "asthma_fatality"
      }
    ],
    "causes": [
      {
        "cause_id": "asthma",
        "target": {
          "source": {
            "data_type": "who_ghe.cause_death_rate",
            "parameters": {
              "country": "$country",
              "cause": "asthma",
              "release": "GHE 2021"
            }
          },
          "unit": "deaths_per_person_repeated_over_band_ages",
          "age_bands": [
            [
              0,
              4
            ],
            [
              5,
              14
            ],
            [
              15,
              29
            ],
            [
              30,
              49
            ],
            [
              50,
              59
            ],
            [
              60,
              69
            ],
            [
              70,
              100
            ]
          ],
          "meaning": "WHO Global Health Estimates 2021 cause-specific deaths divided by population, by sex and GHE age band, applied to the opening population."
        },
        "age_shape": {
          "product_of": [
            {
              "data_type": "fhdb.epidemiology",
              "parameters": {
                "country": "$country",
                "disease": "Asthma",
                "measure": "deaths"
              }
            },
            {
              "data_type": "fhdb.epidemiology",
              "parameters": {
                "country": "$country",
                "disease": "Asthma",
                "measure": "prevalence"
              }
            }
          ]
        },
        "attributed_death_rates": {
          "asthma_fatality": 1
        },
        "fitted_rates": [
          "asthma_fatality"
        ]
      }
    ],
    "stationarity_fits": [
      {
        "rate": "asthma_remission",
        "prevalent_states": [
          "AsthmaEpsd"
        ],
        "age_bands": [
          [
            0,
            4
          ],
          [
            5,
            9
          ],
          [
            10,
            14
          ],
          [
            15,
            19
          ],
          [
            20,
            24
          ],
          [
            25,
            29
          ],
          [
            30,
            39
          ],
          [
            40,
            49
          ],
          [
            50,
            59
          ],
          [
            60,
            69
          ],
          [
            70,
            79
          ],
          [
            80,
            100
          ]
        ],
        "multiplier_bounds": [
          0.5,
          10.0
        ],
        "meaning": "GBD asthma incidence counts new episodes, including relapse after remission. Remission is the rate the source data identify least well, so it is the one fitted to stationary prevalence."
      }
    ],
    "assumptions": [
      "The asthma fatality input is scaled by sex and age so year-one asthma deaths equal WHO GHE 2021 asthma deaths.",
      "Remission is scaled by GBD age band, within 0.5 to 10 times the Spectrum value, so the year carries observed prevalence forward unchanged. Remitted people can have asthma again through incidence.",
      "Other-cause mortality is the demographic all-cause rate less modelled disease deaths, applied at the annual rebase."
    ]
  }
}
