{
  "schema": "forecast-health.disease-opening-state-recipe.v1",
  "module_id": "asthma_epidemiology_core",
  "owner": {
    "repo_id": "ncd-asthma"
  },
  "version": "v2",
  "method": "observed_durable_prevalence_with_balanced_transient_states",
  "compiler_disease_key": "asthma",
  "reconciliation_module_id": "opening-state-reconciliation",
  "purpose": "Allocate observed opening asthma prevalence to the asthma state and calculate the disease-free residual before the first model year.",
  "population_source": {
    "data_type": "fhdb.population",
    "parameters": {
      "country": "$country"
    }
  },
  "residual_state": {
    "target_node_id": "DsFreeSus",
    "meaning": "People outside the asthma state in this marginal disease partition."
  },
  "durable_states": [
    {
      "target_node_id": "AsthmaEpsd",
      "meaning": "Opening asthma episode population.",
      "prevalence_source": {
        "data_type": "fhdb.epidemiology",
        "parameters": {
          "country": "$country",
          "disease": "Asthma",
          "measure": "prevalence"
        }
      }
    }
  ],
  "transient_states": [],
  "scenario_policy": {
    "inputs": "baseline_only",
    "comparison_intervention_inputs_allowed": false,
    "artifact_reuse": "same_content_hash_for_baseline_and_all_comparisons"
  },
  "method_boundaries": [
    "Observed asthma prevalence is authoritative for the opening asthma stock.",
    "No disease rate is changed by this opening-state method.",
    "The disease-free residual and asthma state conserve the demographic population in every age-sex cell."
  ],
  "lowering": {
    "mode": "botech_initialization_overwrite",
    "remove_scheduled_opening_seed_edges": true,
    "runtime_application": "once_before_first_timestep"
  }
}
